{
  "name": "@keydock/sdk",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ky": "^1.9.0"
  },
  "devDependencies": {
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "latest"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "fmt": "oxfmt --write src test",
    "fmt:check": "oxfmt --check src test",
    "lint": "oxlint src test",
    "lint:fix": "oxlint src test --fix",
    "fix": "bun run fmt && bun run lint:fix",
    "qa": "bun run fmt:check && bun run lint && bun run typecheck && bun test"
  }
}
